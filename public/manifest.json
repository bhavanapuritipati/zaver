{
    "name": "Zaver Jewellery",
    "short_name": "Zaver",
    "description": "Premium jewellery collection. Rings, necklaces, earrings, and more.",
    "id": "/",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": [
        "tabbed",
        "standalone",
        "window-controls-overlay"
    ],
    "background_color": "#1a0a0e",
    "theme_color": "#BF3853",
    "orientation": "portrait",
    "dir": "ltr",
    "lang": "en",
    "icons": [
        {
            "src": "/images/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/images/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/images/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Shop Collection",
            "url": "/shop",
            "description": "Browse our latest ring and necklace collections",
            "icons": [
                {
                    "src": "/images/shortcut-emerald.png",
                    "sizes": "640x640",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Shopping Cart",
            "url": "/cart",
            "description": "View items in your cart",
            "icons": [
                {
                    "src": "/images/shortcut-necklace.png",
                    "sizes": "512x512",
                    "type": "image/png"
                }
            ]
        }
    ],
    "screenshots": [
        {
            "src": "/images/screenshot-1.png",
            "sizes": "3456x1992",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Zaver Premium Experience"
        },
        {
            "src": "/images/screenshot-mobile.png",
            "sizes": "1000x6978",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Zaver Mobile Experience"
        }
    ],
    "categories": [
        "shopping",
        "lifestyle"
    ],
    "prefer_related_applications": false,
    "related_applications": [
        {
            "platform": "play",
            "url": "https://play.google.com/store/apps/details?id=com.zaver.app",
            "id": "com.zaver.app"
        },
        {
            "platform": "windows",
            "url": "https://www.microsoft.com/store/apps/9NBLGGH4X123"
        }
    ],
    "iarc_rating_id": "e6bd45ce-706f-4dff-9b21-4d1fb2f6bd9b",
    "scope_extensions": [
        {
            "origin": "*.zaver.vercel.app"
        }
    ],
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "image/*": [
                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".webp"
                ]
            }
        }
    ],
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "protocol_handlers": [
        {
            "protocol": "web+zaver",
            "url": "/?url=%s"
        }
    ],
    "share_target": {
        "action": "/share-target",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "widgets": [
        {
            "name": "Zaver Shopping Widget",
            "short_name": "Zaver",
            "description": "Quickly access the latest Zaver collections.",
            "tag": "zaver-widget",
            "template_url": "/",
            "has_configuration_ui": false,
            "icons": [
                {
                    "src": "/images/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ],
    "edge_side_panel": {
        "preferred_width": 400
    },
    "note_taking": {
        "new_note_url": "/new-note"
    }
}
